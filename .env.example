# Production origin — drives every canonical, hreflang, OG URL, JSON-LD entity
# URL, sitemap and robots entry. No trailing slash. Defaults to
# https://auraplex.com.my in lib/seo.ts if unset.
NEXT_PUBLIC_SITE_URL=https://auraplex.com.my

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
# Shared secret for the /api/revalidate webhook (Sanity → on-demand ISR)
SANITY_REVALIDATE_SECRET=

# Vercel KV
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Resend
RESEND_API_KEY=

# Anthropic (Machine Finder)
ANTHROPIC_API_KEY=

# Analytics — NOTE: not yet wired into the app (no Plausible script is
# loaded anywhere). Set this and add the script tag when analytics go live.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=auraplex.com.my
